    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "^8.0.0-rc.10",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.3.0",
    "@types/node": "^22.20.2",
    "prisma": "^8.0.0-rc.14"
  }
