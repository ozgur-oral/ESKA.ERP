{
  "name": "eska-erp",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "ESKA.ERP - Enterprise Resource Planning System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
