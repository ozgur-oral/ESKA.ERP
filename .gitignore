# ============================================================
# ESKA.ERP - Git Ignore
# ============================================================

# Environment / secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Dependencies
node_modules/
**/node_modules/

# Next.js
.next/
**/.next/

# Build outputs
dist/
**/dist/
build/
**/build/
out/
**/out/

# TypeScript build cache
*.tsbuildinfo
**/*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
temp-*
tmp/
**/tmp/

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# ESKA.ERP document binary storage
apps/api/storage/documents/
storage/documents/

# Local release / development archives
ESKA_ERP_*_RELEASE_*.zip
README-ESKA-ERP-v*.md

# Development backup files
*.bak
*.bak2
*.bak3
